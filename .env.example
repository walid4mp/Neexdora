# Copy to .env (git-ignored) and fill with YOUR OWN values, then run:
#   flutter run --dart-define-from-file=.env
# In GitHub Actions these come from repository Secrets — see SETUP_NEW_SERVICES_AR.md
# Only PUBLIC / client-safe values belong here. Service-role keys, API secrets,
# Firebase service accounts and the keystore must NEVER be in the app or in git.

SUPABASE_URL=
SUPABASE_ANON_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
GIPHY_API_KEY=
