# Edge Function secrets — set with:  supabase secrets set --env-file supabase/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.)
FIREBASE_SERVICE_ACCOUNT=      # full JSON of a Firebase service account, on ONE line
LIVEKIT_URL=                   # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=                  # optional fallback provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
YOUTUBE_API_KEY=
CRON_SECRET=                   # >= 16 random chars; same value stored in Vault as 'cron_secret'
# optional tuning
AI_USER_DAILY_LIMIT=40
AI_GLOBAL_DAILY_LIMIT=5000
AI_BURST_PER_MINUTE=12
